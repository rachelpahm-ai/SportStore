@* View nhận dữ liệu SignUpViewModel *@
@model DBSportStore.Models.SignUpViewModel

@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="auth-page">

    <div class="auth-card">

        <h2>Đăng ký tài khoản</h2>

        <p class="auth-subtitle">
            Tạo tài khoản Customer để đăng nhập mua hàng.
        </p>


        @* ==================== THÔNG BÁO TEST ==================== *@

        @if (ViewBag.SignUpTest != null)
        {
            <div class="cart-message cart-message-success">
                @ViewBag.SignUpTest
            </div>
        }


        @* Form POST về AccountController.SignUp *@
        @using (Html.BeginForm(
            "SignUp",
            "Account",
            FormMethod.Post))
        {
            @* Token bảo vệ form POST *@
            @Html.AntiForgeryToken()


            @* Hiển thị lỗi chung do Controller thêm vào ModelState *@
            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" })


            @* ==================== USERNAME ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.UserName)

                @Html.TextBoxFor(
                    m => m.UserName,
                    new
                    {
                        @class = "form-control-modern",
                        placeholder = "Nhập tên đăng nhập"
                    })

                @Html.ValidationMessageFor(
                    m => m.UserName,
                    "",
                    new { @class = "text-danger" })

            </div>


            @* ==================== PASSWORD ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.Password)

                @Html.PasswordFor(
                    m => m.Password,
                    new
                    {
                        @class = "form-control-modern",
                        placeholder = "Ít nhất 6 ký tự"
                    })

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "text-danger" })

            </div>


            @* ==================== CONFIRM PASSWORD ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.ConfirmPassword)

                @Html.PasswordFor(
                    m => m.ConfirmPassword,
                    new
                    {
                        @class = "form-control-modern",
                        placeholder = "Nhập lại mật khẩu"
                    })

                @Html.ValidationMessageFor(
                    m => m.ConfirmPassword,
                    "",
                    new { @class = "text-danger" })

            </div>


            @* ==================== HỌ TÊN ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.FullName)

                @Html.TextBoxFor(
                    m => m.FullName,
                    new { @class = "form-control-modern" })

                @Html.ValidationMessageFor(
                    m => m.FullName,
                    "",
                    new { @class = "text-danger" })

            </div>


            @* ==================== SỐ ĐIỆN THOẠI ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.Phone)

                @Html.TextBoxFor(
                    m => m.Phone,
                    new { @class = "form-control-modern" })

                @Html.ValidationMessageFor(
                    m => m.Phone,
                    "",
                    new { @class = "text-danger" })

            </div>


            @* ==================== EMAIL ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.Email)

                @Html.TextBoxFor(
                    m => m.Email,
                    new { @class = "form-control-modern" })

                @Html.ValidationMessageFor(
                    m => m.Email,
                    "",
                    new { @class = "text-danger" })

            </div>


            @* ==================== ĐỊA CHỈ ==================== *@

            <div class="auth-field">

                @Html.LabelFor(m => m.Address)

                @Html.TextBoxFor(
                    m => m.Address,
                    new { @class = "form-control-modern" })

                @Html.ValidationMessageFor(
                    m => m.Address,
                    "",
                    new { @class = "text-danger" })

            </div>


            <button type="submit"
                    class="btn-brand auth-submit">
                Đăng ký
            </button>
        }

    </div>

</div>
