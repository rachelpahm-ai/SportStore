
@model IEnumerable<DBSportStore.Models.OrderPro>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>Quản lý đơn hàng</h2>

<p>
    @Html.ActionLink("Thêm đơn hàng mới", "Create", null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th>Địa chỉ giao hàng</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.FullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ShippingAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit",
                        new { id = item.OrderID }) |
                    @Html.ActionLink("Chi tiết", "Details",
                        new { id = item.OrderID }) |
                    @Html.ActionLink("Xóa", "Delete",
                        new { id = item.OrderID })
                </td>
            </tr>
        }
    </tbody>
</table>
