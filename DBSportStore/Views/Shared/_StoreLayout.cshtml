@* ===== LAYOUT DÙNG CHUNG CHO TOÀN WEBSITE ===== *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - SportStore</title>

    @Styles.Render("~/Content/css")
    <link href="~/Content/sportstore.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>
    @* ===== THANH THÔNG BÁO ===== *@
    <div class="store-topbar">
        <div class="container">
            Miễn phí giao hàng cho đơn từ 1.000.000đ
        </div>
    </div>

    @* ===== HEADER ===== *@
    <header class="store-header">
        <div class="container">

            @* LOGO *@
            <a class="brand"
               href="@Url.Action("Index", "Store")">
                SPORT<span>STORE</span>
            </a>

            @* ===== MENU CHÍNH ===== *@
            <nav class="store-nav">

                @* MENU CHUNG CHO TẤT CẢ *@

                @Html.ActionLink(
                    "Giới thiệu",
                    "AboutStore",
                    "Store")

                @Html.ActionLink(
                    "Trang chủ",
                    "Index",
                    "Store")

                @* GIỎ HÀNG *@
                @{ Html.RenderAction(
                        "BagCart",
                        "ShoppingCart");
                }

                @* ===== KHÁCH CHƯA ĐĂNG NHẬP ===== *@
                @if (Session["UserID"] == null)
                {
                    @Html.ActionLink(
                        "Đăng ký",
                        "SignUp",
                        "Account")

                    @Html.ActionLink(
                        "Đăng nhập",
                        "Login",
                        "Account")
                }
                else
                {
                    @* ===== MENU DÀNH CHO ADMIN ===== *@
                    if (Convert.ToString(Session["Role"]) == "Admin")
                    {
                        @Html.ActionLink(
                            "Quản trị",
                            "Index",
                            "Admin")

                        @Html.ActionLink(
                            "Sản phẩm",
                            "Index",
                            "Products")

                        @Html.ActionLink(
                            "Danh mục",
                            "Index",
                            "Categories")

                        @Html.ActionLink(
                            "Đơn hàng",
                            "Index",
                            "OrderProes")
                    }

                    @* ===== THÔNG TIN NGƯỜI DÙNG ===== *@
                    <span class="nav-user">
                        Xin chào
                        @(Session["FullName"] ?? Session["UserName"])
                    </span>

                    @* ===== ĐĂNG XUẤT ===== *@
                    using (Html.BeginForm(
                        "Logout",
                        "Account",
                        FormMethod.Post,
                        new { @class = "nav-logout-form" }))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="nav-link-button">
                            Đăng xuất
                        </button>
                    }
                }

            </nav>
        </div>
    </header>

    @* ===== NỘI DUNG WEBSITE ===== *@
    <main class="container">
        @RenderBody()
    </main>

    @* ===== FOOTER ===== *@
    <footer class="store-footer">
        <div class="container">
            <strong>SPORTSTORE</strong><br />
            Website thương mại thực hành ASP.NET MVC5
        </div>
    </footer>

    @* ===== JAVASCRIPT ===== *@
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>
